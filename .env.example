# Lunacuento es un sitio estático: no hay secretos de servidor. Todo lo que empieza con NEXT_PUBLIC_
# se incrusta en el JavaScript al compilar (`npm run build:app`) y es público por diseño.
# Nunca subir claves reales al repo: copiar este archivo a .env.local y completar los valores.

# RevenueCat · claves PÚBLICAS del SDK (Project settings > API keys > "Public app-specific API keys").
# iOS empieza con "appl_"; Android con "goog_". No son la "secret key".
# Si están vacías, la app funciona pero las compras responden "no disponible".
NEXT_PUBLIC_RC_IOS_KEY=
NEXT_PUBLIC_RC_ANDROID_KEY=

# Ids fijos (no son variables): producto "lunacuento_biblioteca", entitlement "biblioteca". Ver src/lib/purchases.ts.

# Modo de prueba · NEXT_PUBLIC_MODO_PRUEBA=1 desbloquea TODOS los cuentos premium y oculta la pantalla de compra,
# para probar la funcionalidad antes de configurar los pagos. Vacía (o ausente) = comportamiento normal.
# Se incrusta al compilar: tras cambiarla hay que volver a compilar (`npm run build` / `npm run build:app`) o redesplegar.
# En el pie del sitio aparece "Modo de prueba" mientras esté activa. NO activarla en la versión que se publica en las tiendas.
NEXT_PUBLIC_MODO_PRUEBA=

# OPENAI_API_KEY · SOLO para scripts/generar-ilustraciones.mjs en tu máquina (no la usa el sitio ni la app).
# Ponla en .env.local (ignorado por git) o expórtala en la terminal. Nunca la subas al repo.
OPENAI_API_KEY=
